{
  "name": "lumi-pet-mini",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/mini/server.js",
    "dev": "node --env-file-if-exists=.env --watch apps/mini/server.js",
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "pet:validate": "python3 tools/validate_pet.py",
    "pet:build": "python3 workflows/lumi-actions-v3/compose_package.py",
    "pet:extract": "python3 workflows/lumi-actions-v3/extract_alpha_row.py",
    "pet:install": "python3 tools/install_pet.py"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "zod": "^3.25.76"
  },
  "description": "Lumi pet assets, animation workflow and companion mini app",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/mini"
  ]
}
